{
  "manifest_version": 3,
  "name": "RET Page Lens",
  "version": "0.2.3",
  "description": "Review readable article captures and connect visible media to your private Reading Room.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture this article"
  },
  "content_scripts": [
    {
      "matches": [
        "https://reader.example.org/capture*",
        "https://dayofflondon.com/capture*",
        "https://www.dayofflondon.com/capture*",
        "http://127.0.0.1/capture*",
        "http://localhost/capture*",
        "https://reader.example.org/capture-review*",
        "https://dayofflondon.com/capture-review*",
        "https://www.dayofflondon.com/capture-review*",
        "http://127.0.0.1/capture-review*",
        "http://localhost/capture-review*"
      ],
      "js": [
        "handoff.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://reader.example.org/page-lens-connect*",
        "https://dayofflondon.com/page-lens-connect*"
      ],
      "js": [
        "bridge-connect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://reader.example.org/*"
  ],
  "optional_host_permissions": [
    "https://dayofflondon.com/*"
  ],
  "background": {
    "service_worker": "bridge-worker.js"
  }
}
